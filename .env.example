# Local runs only (GitHub Actions uses repository secrets with the same names). Never commit .env.
SNOW_ACCOUNT=fs03183.ap-south-1.aws
SNOW_USER=
SNOW_PRIVATE_KEY=          # full PEM text incl. BEGIN/END lines, or base64 of it
SNOW_KEY_PASSPHRASE=       # only if the key is encrypted
SNOW_ROLE=
SNOW_WH=SNITCH_WH
CF_ACCOUNT_ID=             # optional locally: without CF_* the build only writes index.html
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
